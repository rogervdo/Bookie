# Local SQLite by default. Override for Aiven, Supabase, or Neon Postgres.
# DATABASE_URL=sqlite+aiosqlite:///./data/speaking.db

# Aiven PostgreSQL (use postgresql+asyncpg for the app; sslmode=require for Aiven):
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/defaultdb?sslmode=require

# Supabase Postgres:
# DATABASE_URL=postgresql+asyncpg://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Local WAV cache directory (audio bytes are never stored in the database).
# AUDIO_CACHE_DIR=./data/audio_cache

# Optional: object storage key prefix when syncing cached audio to R2/Supabase Storage.
# Set per-entry via AudioCache.write(object_key=...).
